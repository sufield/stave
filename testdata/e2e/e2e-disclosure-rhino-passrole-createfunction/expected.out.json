      "finding_id": "sha256:07d1168a24095b76",
      "control_id": "CTL.IAM.ESCALATE.PASSROLE.CREATEFUNCTION.001",
      "control_name": "Principal Must Not Escalate via Lambda CreateFunction Execution Role",
      "control_description": "Principals with iam:PassRole on a role R, lambda:CreateFunction, and a path to invoke the function (lambda:InvokeFunction directly, creation of a function URL, or wiring to another trigger) can escalate to R's permissions. The created Lambda executes under R, so any code the principal uploads runs with R's authority. When R's effective permissions exceed the principal's own, this is a privilege escalation path. Rhino Security Labs' iam__privesc_scan and Prowler's iam_policy_allows_privilege_escalation both enumerate this technique. The invocation step is folded into the .present boolean upstream — a CreateFunction grant without any invocation path is not an escalation; the diagnostic fields expose which invocation vector was observed.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2018-05-01T00:00:00Z",
        "last_seen_unsafe_at": "2018-05-11T00:00:00Z",
        "unsafe_duration_hours": 67488,
        "misconfigurations": [
          {
            "property": "identity.escalation.passrole_createfunction.present",
            "actual_value": true,
            "operator": "eq",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 67488 hours (SLA: 0 hours). Exposed since 2018-05-01T00:00:00Z."
      },
      "control_severity": "high",
      "control_compliance": {
