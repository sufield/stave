      ],
      "posture_drift": {
        "pattern": "persistent",
        "exposure_window_count": 1
      },
      "remediation": {
        "description": "Principal has `iam:AttachUserPolicy` scoped to its own user ARN (either explicitly by ARN, by `\"*\"`, or by a user-set that includes it). It can attach any managed policy to itself, including `AdministratorAccess`, and become admin without any further vulnerability.",
        "action": "Remove `iam:AttachUserPolicy` from the principal, or scope its Resource field to user ARNs that do not include the principal itself (admin-only bootstrap roles, for example). Enforce at the organization level with an SCP that denies `iam:AttachUserPolicy` on `${aws:PrincipalArn}`. Also consider a permissions boundary on the principal that prevents the attached policy from taking effect.",
        "example": "{\n  \"identity\": {\n    \"kind\": \"user\",\n    \"escalation\": {\n      \"attach_user_policy_self\": {\n        \"present\": false\n      }\n    }\n  }\n}\n"
      },
      "fix_plan": {
        "id": "fix-3007c7be8b5a54c2",
        "target": {
          "asset_id": "arn:aws:iam::111122223333:user/eve",
          "asset_type": "aws_iam_user"
        },
        "action": "Remove `iam:AttachUserPolicy` from the principal, or scope its Resource field to user ARNs that do not include the principal itself (admin-only bootstrap roles, for example). Enforce at the organization level with an SCP that denies `iam:AttachUserPolicy` on `${aws:PrincipalArn}`. Also consider a permissions boundary on the principal that prevents the attached policy from taking effect."
      },
