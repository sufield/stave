        "IVS-03"
      ],
      "posture_drift": {
        "pattern": "persistent",
        "exposure_window_count": 1
      },
      "remediation": {
        "description": "CodeBuild webhook filter patterns are not anchored with ^ and $.",
        "action": "Update all ACTOR_ACCOUNT_ID, HEAD_REF, and BASE_REF filter patterns to use ^ (start anchor) and $ (end anchor) for exact matching. Example: change \"12345\" to \"^12345$\".",
        "example": "{\n  \"compute\": {\n    \"kind\": \"codebuild_project\",\n    \"webhook\": { \"filters_anchored\": true }\n  }\n}\n"
      },
      "fix_plan": {
        "id": "fix-daee8244c30eeb16",
