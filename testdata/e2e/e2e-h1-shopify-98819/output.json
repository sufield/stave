      "control_id": "CTL.S3.AUTH.READ.001",
      "control_name": "No Authenticated-Users Read Access",
      "control_description": "S3 buckets must not grant read access to all authenticated AWS users. AuthenticatedUsers scope means any AWS account can read objects, which is nearly as dangerous as fully public access.\n",
      "asset_id": "shopify-internal-assets",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2015-11-15T00:00:00Z",
        "last_seen_unsafe_at": "2015-11-23T00:00:00Z",
        "unsafe_duration_hours": 89040,
        "threshold_hours": 168,
        "misconfigurations": [
          {
