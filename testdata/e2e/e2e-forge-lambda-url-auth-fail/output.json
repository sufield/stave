      "remediation": {
        "description": "Lambda function URL is configured with AuthType NONE. The function is publicly invocable from any source on the internet with no authentication. The function's IAM execution role permissions are available to any caller. Invocation costs are unbounded.",
        "action": "Set the function URL AuthType to AWS_IAM to require IAM signature authentication for all invocations. If the function URL is not needed, remove it entirely via aws lambda delete-function-url-config. Note that Lambda resource-based policy restrictions do not apply to function URL invocations — AuthType is the only authentication gate for function URLs.",
        "example": "{\n  \"compute\": {\n    \"kind\": \"function\",\n    \"function_url\": {\n      \"auth_type_none\": false\n    }\n  }\n}\n"
      },
      "fix_plan": {
        "id": "fix-41074b4abfd88036",
        "target": {
          "asset_id": "arn:aws:lambda:us-east-1:123456789012:function:public-api",
          "asset_type": "aws_lambda_function"
        },
