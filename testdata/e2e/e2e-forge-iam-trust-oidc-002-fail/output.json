      },
      "remediation": {
        "description": "OIDC trust policy uses a wildcard subject claim. Any identity from the provider can assume this role.",
        "action": "Replace the wildcard with an exact subject match. For GitHub Actions: \"repo:myorg/myrepo:ref:refs/heads/main\". For GitLab CI: \"project_path:mygroup/myproject:ref_type:branch:ref:main\".",
