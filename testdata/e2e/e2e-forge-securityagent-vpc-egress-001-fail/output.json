      "control_id": "CTL.SECURITYAGENT.VPC.EGRESS.001",
      "control_name": "Security Agent VPC Must Restrict Egress",
      "control_description": "AWS Security Agent runs in a VPC with unrestricted egress. The agent's security group allows outbound traffic to 0.0.0.0/0, meaning the agent can reach any external endpoint. A compromised or misconfigured agent with unrestricted egress can exfiltrate data to attacker-controlled infrastructure or establish C2 communication channels. The VPC placement provides no isolation benefit when egress is unrestricted.\n",
      "asset_id": "secagent-job-webapp-pentest",
      "asset_type": "aws_securityagent_job",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 5494.43530619547,
        "misconfigurations": [
