      "finding_id": "sha256:7ddc23cd142ae468",
      "control_id": "CTL.IAM.POLICY.SHADOW.001",
      "control_name": "IAM Policy Must Not Use NotAction Construct",
      "control_description": "IAM policies using NotAction or NotResource create negative logic that is prone to bypass. A NotAction policy says \"allow everything EXCEPT these actions\" — but the list of excepted actions rarely covers all dangerous permissions. New AWS services and actions are automatically allowed by the implicit \"everything else\" grant. Attackers exploit this shadow effect to find actions like iam:PutRolePolicy that fall through the negative logic gap.\n",
      "asset_id": "arn:aws:iam::123:policy/dev-policy",
      "asset_type": "aws_iam_policy",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
        "threshold_hours": 168,
        "misconfigurations": [
