            "property": "identity.kind",
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "unsafe_value": "policy"
          },
          {
            "property": "identity.policy.shadow_logic.has_not_action",
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "unsafe_value": true
          }
        ],
        "root_causes": [
