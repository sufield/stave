        "exposure_window_count": 1
      },
      "remediation": {
        "description": "IAM policy uses NotAction or NotResource. Negative logic creates an implicit allow for all actions and resources not in the exclusion list.",
        "action": "Replace NotAction with an explicit Allow list. Enumerate the specific actions needed and grant only those. Negative logic is prone to bypass as new AWS services and actions are added.",
        "example": "{\n  \"identity\": {\n    \"kind\": \"policy\",\n    \"policy\": {\n      \"shadow_logic\": {\n        \"has_not_action\": false,\n        \"has_not_resource\": false\n      }\n    }\n  }\n}\n"
      }
