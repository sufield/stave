      "control_id": "CTL.GCS.PUBLIC.001",
      "control_name": "No Public GCS Bucket Read",
      "control_description": "GCS buckets must not allow public read access. Detects buckets where IAM bindings include allUsers or allAuthenticatedUsers with read permissions, or where uniform bucket-level access is disabled and object ACLs may grant public access.\n",
      "asset_id": "my-project-public-bucket",
      "asset_type": "gcp_gcs_bucket",
      "asset_vendor": "gcp",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
        "misconfigurations": [
          {
