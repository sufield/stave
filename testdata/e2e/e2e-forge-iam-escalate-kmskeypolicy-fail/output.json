      "finding_id": "sha256:c98272141517c067",
      "control_id": "CTL.IAM.ESCALATE.KMSKEYPOLICY.001",
      "control_name": "Principal Must Not Escalate via KMS PutKeyPolicy",
      "control_description": "Principals with kms:PutKeyPolicy can replace the key policy on any KMS key within scope. The attacker adds themselves as a key user with kms:Decrypt permission. All data encrypted by the key — S3 objects, EBS volumes, RDS snapshots, Secrets Manager secrets — becomes decryptable. Unlike kms:CreateGrant which adds a temporary grant, PutKeyPolicy modifies the permanent authorization on the key.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
