      "finding_id": "sha256:e7d6281840eca52e",
      "control_id": "CTL.KMS.POLICY.CROSSACCOUNT.001",
      "control_name": "KMS Key Policy Must Not Grant Broad Cross-Account Access",
      "control_description": "KMS key policies must not grant kms:Decrypt, kms:Encrypt, kms:GenerateDataKey, or kms:* to external account principals without restricting via kms:CallerAccount, kms:ViaService, or aws:PrincipalOrgID conditions. Unlike IAM policies, the key policy is the primary authorization mechanism — IAM policies alone cannot grant KMS access unless the key policy permits it. Broad cross-account key access allows external principals to decrypt every resource encrypted by this key.\n",
      "asset_id": "arn:aws:kms:us-east-1:111122223333:key/mrk-abcdef1234567890",
      "asset_type": "aws_kms_key",
      "asset_vendor": "aws",
