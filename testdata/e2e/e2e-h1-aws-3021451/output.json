      "control_id": "CTL.CLOUDTRAIL.ELASTICACHE.ENDPOINT.BLIND.001",
      "control_name": "CloudTrail Does Not Cover All ElastiCache API Endpoints",
      "control_description": "CloudTrail does not log ElastiCache events from all reachable API endpoints. ElastiCache exposes a non-production endpoint (elasticache.\u003cregion\u003e.api.aws) through which API calls bypass CloudTrail entirely, creating an unaudited channel for cache cluster manipulation, data exfiltration, and detection evasion. A trail reporting full coverage via the standard endpoint masks this blind spot.\n",
      "asset_id": "arn:aws:cloudtrail:us-east-1:111122223333:trail/org-trail",
      "asset_type": "aws_cloudtrail_trail",
      "asset_vendor": "aws",
