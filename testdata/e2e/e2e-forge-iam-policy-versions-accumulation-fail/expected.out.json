      "control_name": "Managed Policy Has Multiple Versions",
      "control_description": "A customer-managed IAM policy has more than one version. Dormant versions may contain broader permissions that can be activated via iam:SetDefaultPolicyVersion — a single-API-call escalation path. Policies should be cleaned to a single version after changes are verified.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
