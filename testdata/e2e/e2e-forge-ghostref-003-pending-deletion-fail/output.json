      "finding_id": "sha256:d3bdbbe5319d12ae",
      "control_id": "CTL.IAM.POLICY.GHOSTREF.003",
      "control_name": "Dangling KMS Key References Must Not Exist in Active Policies",
      "control_description": "IAM policies granting KMS permissions must only reference KMS key ARNs in enabled status. A policy referencing a pending-deletion or deleted KMS key means systems depending on that policy for encrypt/decrypt operations will fail silently — data integrity violations for PHI workloads. KMS key ARNs include the account ID and a random key ID so they cannot be claimed cross-account, but the operational impact of referencing a non-functional key is a direct compliance failure.\n",
      "asset_id": "arn:aws:iam::111122223333:role/encrypt-role",
      "asset_type": "aws_iam_role",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
