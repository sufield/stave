      "control_id": "CTL.KMS.POLICY.CONDITION.001",
      "control_name": "KMS Key Policy Must Include Protective Conditions",
      "control_description": "KMS key policies granting usage actions (kms:Decrypt, kms:Encrypt, kms:GenerateDataKey*, kms:ReEncrypt*) should include at least one protective condition: kms:ViaService (restricts which AWS service can use the key), kms:CallerAccount (restricts which account can call through the service), or kms:EncryptionContext (restricts the context in which the key can be used). Without conditions, any principal granted by the policy can use the key for any purpose from any service — the policy is authorization without scope.\n",
      "asset_id": "arn:aws:kms:us-east-1:111122223333:key/mrk-cbcdef1234567890",
      "asset_type": "aws_kms_key",
