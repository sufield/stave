            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.lifecycle.rules_configured",
            "unsafe_value": false
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "present",
            "property": "storage.tags.data-retention",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 168 hours). Exposed since 2026-01-01T00:00:00Z.",
        "threshold_hours": 168,
        "unsafe_duration_hours": 240
      },
      "finding_id": "sha256:c05742c8ab061c1f",
      "posture_drift": {
        "exposure_window_count": 1,
        "pattern": "persistent"
      },
      "remediation": {
        "action": "Add S3 lifecycle rules to manage object expiration and transitions. Configure rules matching the retention period specified in the data-retention tag. Use lifecycle transitions to move data to cheaper storage classes before expiration.",
        "description": "Bucket tagged with data-retention has no lifecycle rules configured. Data persists indefinitely, violating retention policy requirements.",
        "example": "{\n  \"storage\": {\n    \"tags\": {\n      \"data-retention\": \"7-years\"\n    },\n    \"lifecycle\": {\n      \"rules_configured\": true\n    }\n  }\n}\n"
      }
    },
