      "control_id": "CTL.IAM.POLICY.RESOURCE.WILDCARD.001",
      "control_name": "Sensitive Actions Must Not Use Resource Wildcard",
      "control_description": "IAM policies granting sensitive actions (s3:*, kms:Decrypt, dynamodb:*, secretsmanager:GetSecretValue, rds:*, ec2:*, lambda:InvokeFunction, sts:AssumeRole) must scope the Resource element to specific ARNs. Resource \"*\" on sensitive actions grants the action on every resource in the account, vastly exceeding least privilege. CTL.IAM.POLICY.PASSROLE.001 and CTL.IAM.POLICY.ASSUMEROLE.001 enforce resource scoping for PassRole and AssumeRole specifically; this control generalizes the pattern to all sensitive actions.\n",
      "asset_id": "arn:aws:iam::111122223333:user/analyst",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
