      "remediation": {
        "description": "IAM role grants access to resources in an external AWS account.",
        "action": "Remove cross-account resource ARNs from identity-based policies. If cross-account access is required, use a resource-based policy on the target resource or an explicit cross-account role assumption via sts:AssumeRole with ExternalId conditions.",
        "example": "{\n  \"identity\": {\n    \"kind\": \"role\",\n    \"policies\": {\n      \"has_cross_account_resource\": false\n    }\n  }\n}\n"
      },
