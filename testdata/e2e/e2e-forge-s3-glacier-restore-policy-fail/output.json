      "control_id": "CTL.S3.GLACIER.RESTORE.POLICY.001",
      "control_name": "Glacier Restore Creates Temporarily Accessible Copy",
      "control_description": "Glacier-archived objects that are restored inherit the bucket's access policy without additional restrictions. If the bucket policy allows broad access, the restored copy is accessible to anyone the bucket policy permits during the restore window. Glacier archival is often treated as a security boundary but restored objects become standard S3 objects for the duration of the restore window.\n",
      "asset_id": "arn:aws:s3:::prod-archive-primary",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
        "threshold_hours": 168,
        "misconfigurations": [
