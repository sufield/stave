      "control_description": "S3 bucket policies must not grant access to external AWS accounts. `allowed_accounts` contains trusted external AWS account IDs (12-digit). Access from accounts outside this allowlist is unsafe.\n",
      "control_id": "CTL.S3.ACCESS.001",
      "control_name": "No Unauthorized Cross-Account Access",
      "control_severity": "high",
      "evidence": {
