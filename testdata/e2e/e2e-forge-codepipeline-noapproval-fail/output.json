      "control_id": "CTL.CODEPIPELINE.NOAPPROVAL.001",
      "control_name": "CodePipeline Must Have Manual Approval Before Production Deploy",
      "control_description": "CodePipeline that deploys to production must include a manual approval action. Without a human gate, a compromised source repository or build stage can push adversarial code directly to production — a SageMaker endpoint, ECS service, or Lambda function — with no review step.\n",
      "asset_id": "test-codepipeline-pipeline",
      "asset_type": "aws_codepipeline_pipeline",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
        "misconfigurations": [
          {
            "property": "compute.governance.has_manual_approval",
            "actual_value": false,
            "operator": "ne",
            "unsafe_value": true
          },
          {
            "property": "compute.kind",
            "actual_value": "codepipeline_pipeline",
