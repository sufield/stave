      "remediation": {
        "description": "CodePipeline has no manual approval stage before production deploy.",
        "action": "Add a Manual Approval action before any stage that deploys to production. Configure an SNS topic for approval notifications so the right team is notified. This creates a human checkpoint between build and deploy.",
        "example": "{\n  \"compute\": {\n    \"kind\": \"codepipeline_pipeline\",\n    \"governance\": { \"has_manual_approval\": true }\n  }\n}\n"
      },
