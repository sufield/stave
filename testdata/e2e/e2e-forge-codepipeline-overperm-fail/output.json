      "control_name": "CodePipeline Role Must Follow Least Privilege",
      "control_description": "CodePipeline execution roles must be scoped to the minimum permissions required for each stage. An overprivileged pipeline role lets any stage action — including actions triggered by external source events — access resources beyond the pipeline's scope: deploying to production, modifying IAM policies, or reading secrets the pipeline does not need.\n",
      "asset_id": "test-codepipeline-pipeline",
      "asset_type": "aws_codepipeline_pipeline",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
