      "finding_id": "sha256:402139488adf09e0",
      "control_id": "CTL.IAM.POLICY.INLINE.002",
      "control_name": "No Inline Policies on IAM Roles",
      "control_description": "IAM roles must not have inline policies attached. Inline policies are embedded directly in the role and cannot be versioned, audited, or reused independently. They create shadow permission grants that are invisible to policy-listing tools that only enumerate managed policies. Use managed policies attached to the role instead. CTL.IAM.POLICY.INLINE.001 enforces this for users; this control enforces it for roles.\n",
      "asset_id": "arn:aws:iam::111122223333:role/deploy-role",
      "asset_type": "aws_iam_role",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
