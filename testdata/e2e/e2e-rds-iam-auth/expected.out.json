        "exposure_window_count": 1
      },
      "remediation": {
        "description": "RDS instance does not have IAM authentication enabled. Database access relies on long-lived passwords that are harder to rotate and audit.",
        "action": "Enable IAM authentication on the instance. Run: aws rds modify-db-instance --db-instance-identifier xxx --enable-iam-database-authentication --apply-immediately",
        "example": "{\n  \"database\": {\n    \"kind\": \"instance\",\n    \"access\": {\n      \"iam_authentication_enabled\": true\n    }\n  }\n}\n"
      },
      "fix_plan": {
        "id": "fix-4233e63a00340e1b",
        "target": {
          "asset_id": "phi-database",
          "asset_type": "aws_rds_instance"
        },
        "action": "Enable IAM authentication on the instance. Run: aws rds modify-db-instance --db-instance-identifier xxx --enable-iam-database-authentication --apply-immediately"
      },
      "exploitability": "one_away",
      "near_miss_chains": [
        {
          "chain_id": "rds_auth_weakness",
          "chain_severity": "high",
          "missing_control": "CTL.RDS.AUTH.MASTERUSER.001",
          "description": "IAM authentication is not enabled on the RDS instance AND either the master username matches a well-known default or a Secrets Manager secret on the account has a public resource policy. The authentication path falls back to password-only AND either the username half is free for the attacker (well-known default) or the password half is publicly retrievable (any AWS principal can call GetSecretValue). One condition alone is medium severity; the combination is the database operating with a guessable username and / or a publicly-fetchable password against static-credential authentication.\n"
        },
