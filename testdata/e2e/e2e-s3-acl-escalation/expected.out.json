  "findings": [
    {
      "asset_id": "auth-acl-writable-bucket",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "control_description": "S3 bucket ACLs must not be writable by AllUsers or AuthenticatedUsers. WRITE_ACP permission enables attackers to modify the ACL itself, granting themselves FULL_CONTROL and escalating to read, write, and delete all objects.\n",
      "control_id": "CTL.S3.ACL.ESCALATION.001",
      "control_name": "No Public ACL Modification",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "misconfigurations": [
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.access.authenticated_admin",
            "unsafe_value": true
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.access.public_admin",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "threshold_hours": 168,
        "unsafe_duration_hours": 240,
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 168 hours). Exposed since 2026-01-01T00:00:00Z."
      },
      "posture_drift": {
        "episode_count": 1,
        "pattern": "persistent"
      },
      "remediation": {
        "action": "Remove WRITE_ACP grants from the bucket ACL and remove policy statements granting s3:PutBucketAcl or s3:PutObjectAcl to public principals. Enable S3 Public Access Block with BlockPublicAcls set to true.",
        "description": "Bucket grants ACL modification (WRITE_ACP) to public or authenticated users. An attacker can call PutBucketAcl to grant themselves FULL_CONTROL, then read or modify all objects.",
        "example": "{\n  \"storage\": {\n    \"access\": {\n      \"public_admin\": false,\n      \"authenticated_admin\": false\n    }\n  }\n}\n"
      }
    },
