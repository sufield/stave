      "remediation": {
        "description": "Glue connection does not enforce SSL for JDBC traffic.",
        "action": "Set the JDBC_ENFORCE_SSL connection property to true in the Glue connection configuration.",
        "example": "{\n  \"compute\": {\n    \"kind\": \"glue_connection\",\n    \"network\": { \"ssl_enforced\": true }\n  }\n}\n"
      },
