        "exposure_window_count": 1
      },
      "remediation": {
        "description": "Signed upload policy uses prefix-wide write permissions instead of binding to an exact object key. This enables arbitrary overwrite and cross-tenant tampering.",
        "action": "Change the signed upload policy to use an exact key condition (eq instead of starts-with) that binds each upload to a specific object path. Generate unique object keys server-side.",
        "example": "{\n  \"s3_upload\": {\n    \"operation\": \"write\",\n    \"allowed_key_mode\": \"exact\"\n  }\n}\n"
      },
      "fix_plan": {
        "id": "fix-7899bb837c98d454",
