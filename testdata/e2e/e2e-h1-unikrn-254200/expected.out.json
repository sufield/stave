      "control_id": "CTL.S3.WRITE.SCOPE.001",
      "control_name": "S3 Signed Upload Must Bind To Exact Object Key",
      "control_description": "Signed upload policies must restrict write permission to a single exact object key. Prefix-wide permissions (e.g., starts-with $key files/) enable arbitrary overwrite and cross-tenant tampering.\n",
      "asset_id": "upload-api-unikrn-files",
      "asset_type": "s3_upload_policy",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2017-07-25T00:00:00Z",
        "last_seen_unsafe_at": "2017-08-02T00:00:00Z",
        "unsafe_duration_hours": 74208,
        "threshold_hours": 168,
        "misconfigurations": [
          {
            "property": "s3_upload.allowed_key_mode",
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "unsafe_value": "prefix"
          },
          {
            "property": "s3_upload.operation",
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "unsafe_value": "write"
          },
          {
            "property": "type",
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "unsafe_value": "s3_upload_policy"
          }
