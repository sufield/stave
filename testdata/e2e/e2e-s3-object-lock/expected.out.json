      "control_compliance_ccm_v4": [
        "BCR-08",
        "DSP-16"
      ],
      "control_description": "S3 buckets tagged with any compliance framework (soc2, gdpr, hipaa, pci-dss, etc.) must have S3 Object Lock enabled. Object Lock provides WORM (Write Once Read Many) protection, preventing objects from being deleted or overwritten for a specified retention period. Regulatory frameworks require immutable storage for audit logs, compliance records, and protected data.\n",
      "control_id": "CTL.S3.LOCK.001",
      "control_name": "Compliance-Tagged Buckets Must Have Object Lock Enabled",
      "control_severity": "medium",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "misconfigurations": [
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.kind",
            "unsafe_value": "bucket"
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.object_lock.enabled",
            "unsafe_value": false
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "present",
            "property": "storage.tags.compliance",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 168 hours). Exposed since 2026-01-01T00:00:00Z.",
        "threshold_hours": 168,
        "unsafe_duration_hours": 240
      },
      "finding_id": "sha256:b6d05ff1963bda95",
      "posture_drift": {
        "exposure_window_count": 1,
        "pattern": "persistent"
      },
      "remediation": {
        "action": "Enable S3 Object Lock on the bucket. Note: Object Lock can only be enabled at bucket creation. If the bucket already exists, create a new bucket with Object Lock enabled and migrate objects. Set a default retention period appropriate for your compliance framework.",
        "description": "Compliance-tagged bucket does not have S3 Object Lock enabled. Objects can be deleted or overwritten without WORM protection.",
        "example": "{\n  \"storage\": {\n    \"kind\": \"bucket\",\n    \"tags\": {\n      \"compliance\": \"hipaa\"\n    },\n    \"object_lock\": {\n      \"enabled\": true\n    }\n  }\n}\n"
      }
    },
    {
      "asset_id": "phi-governance-lock",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "control_compliance_ccm_v4": [
        "BCR-08",
        "DSP-16"
      ],
      "control_description": "S3 buckets tagged with data-classification=phi that have Object Lock enabled must use COMPLIANCE mode, not GOVERNANCE mode. COMPLIANCE mode prevents ANY user, including the root account, from deleting or overwriting protected objects during the retention period. GOVERNANCE mode allows users with special permissions to override retention, which is insufficient for HIPAA-regulated PHI data where tamper-proof storage is required.\n",
      "control_id": "CTL.S3.LOCK.002",
      "control_name": "PHI Buckets Must Use COMPLIANCE Mode Object Lock",
      "control_severity": "medium",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "misconfigurations": [
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.object_lock.enabled",
            "unsafe_value": true
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "ne",
            "property": "storage.object_lock.mode",
            "unsafe_value": "COMPLIANCE"
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.tags.data-classification",
            "unsafe_value": "phi"
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 168 hours). Exposed since 2026-01-01T00:00:00Z.",
        "threshold_hours": 168,
        "unsafe_duration_hours": 240
      },
      "finding_id": "sha256:48c4da7865eb8989",
      "posture_drift": {
        "exposure_window_count": 1,
        "pattern": "persistent"
      },
      "remediation": {
        "action": "Change the Object Lock default retention mode from GOVERNANCE to COMPLIANCE. In COMPLIANCE mode, no user (including root) can delete or modify protected objects during the retention period.",
        "description": "PHI bucket with Object Lock is using GOVERNANCE mode instead of COMPLIANCE mode. Users with special permissions can override retention.",
        "example": "{\n  \"storage\": {\n    \"tags\": {\n      \"data-classification\": \"phi\"\n    },\n    \"object_lock\": {\n      \"enabled\": true,\n      \"mode\": \"COMPLIANCE\"\n    }\n  }\n}\n"
      }
    },
    {
      "asset_id": "phi-short-retention",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "control_compliance_ccm_v4": [
        "BCR-08",
        "DSP-16"
      ],
      "control_description": "S3 buckets tagged with data-classification=phi that have Object Lock enabled must have a default retention period of at least 2190 days (6 years) to meet HIPAA minimum retention requirements. Shorter retention periods risk premature expiration of WORM protection, allowing deletion or modification of PHI data before the regulatory retention period has elapsed.\n",
      "control_id": "CTL.S3.LOCK.003",
      "control_name": "PHI Object Lock Retention Must Meet Minimum Period",
      "control_severity": "medium",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "misconfigurations": [
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.object_lock.enabled",
            "unsafe_value": true
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "lt",
            "property": "storage.object_lock.retention_days",
            "unsafe_value": 2190
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.tags.data-classification",
            "unsafe_value": "phi"
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 168 hours). Exposed since 2026-01-01T00:00:00Z.",
        "threshold_hours": 168,
        "unsafe_duration_hours": 240
      },
      "finding_id": "sha256:72a8a7272fee0dad",
      "posture_drift": {
        "exposure_window_count": 1,
        "pattern": "persistent"
      },
      "remediation": {
        "action": "Increase the Object Lock default retention period to at least 2190 days. Use aws s3api put-object-lock-configuration to update the default retention settings.",
        "description": "PHI bucket Object Lock retention period is shorter than the HIPAA minimum of 6 years (2190 days). WORM protection may expire before the regulatory retention period.",
        "example": "{\n  \"storage\": {\n    \"tags\": {\n      \"data-classification\": \"phi\"\n    },\n    \"object_lock\": {\n      \"enabled\": true,\n      \"retention_days\": 2190\n    }\n  }\n}\n"
      }
