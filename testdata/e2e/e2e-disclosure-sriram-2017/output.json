      "control_id": "CTL.S3.PUBLIC.003",
      "control_name": "No Public Write Access",
      "control_description": "S3 buckets must not allow public write or delete access. Public write enables data injection, ransomware, and policy takeover.\n",
      "asset_id": "sriram-logo-bucket",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2017-10-15T00:00:00Z",
        "last_seen_unsafe_at": "2017-10-23T00:00:00Z",
        "unsafe_duration_hours": 72240,
        "threshold_hours": 168,
        "misconfigurations": [
          {
            "property": "storage.access.public_write",
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 72240 hours (SLA: 168 hours). Exposed since 2017-10-15T00:00:00Z."
      },
      "control_severity": "critical",
      "control_compliance_ccm_v4": [
        "DSP-07",
        "DSP-17"
      ],
      "exposure": {
        "type": "public_write",
        "principal_scope": "public"
      },
      "posture_drift": {
        "pattern": "persistent",
        "exposure_window_count": 1
      },
      "remediation": {
        "description": "Bucket allows public write or delete access. Attackers can inject malicious content, overwrite existing objects, or hold data ransom.",
        "action": "Remove bucket policy statements that grant s3:PutObject or s3:DeleteObject to Principal \"*\". Remove ACL grants that allow WRITE or FULL_CONTROL to AllUsers or AuthenticatedUsers. Enable S3 Public Access Block.",
        "example": "{\n  \"storage\": {\n    \"access\": {\n      \"public_write\": false\n    }\n  }\n}\n"
      },
      "fix_plan": {
        "id": "fix-ff1f84e75df75544",
        "target": {
          "asset_id": "sriram-logo-bucket",
          "asset_type": "aws_s3_bucket"
        },
        "preconditions": [
          "Confirm resource ownership and internal change window approval.",
          "Ensure public access is not explicitly required for this specific resource's function."
        ],
        "actions": [
          {
            "action_type": "set",
            "path": "security_posture.block_identity_public_access",
            "value": true
          },
          {
            "action_type": "set",
            "path": "security_posture.block_resource_metadata_access",
            "value": true
          },
          {
            "action_type": "set",
            "path": "security_posture.block_resource_public_access",
            "value": true
          },
          {
            "action_type": "set",
            "path": "security_posture.ignore_resource_metadata_access",
            "value": true
          }
        ],
        "expected_effect": "Enforces a hardened security posture by blocking all identity-bound and resource-bound public access paths."
      }
    },
