      "control_id": "CTL.IAM.ESCALATE.ADDLAYER.001",
      "control_name": "Principal Must Not Escalate via Lambda AddLayerVersionPermission",
      "control_description": "Principals with lambda:AddLayerVersionPermission can modify shared Lambda layers that other functions depend on. If the attacker modifies a widely-used layer, every function using that layer is compromised on next deployment. This is a supply chain attack via Lambda layers — the attacker doesn't modify the function code, they modify a dependency the function imports.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
