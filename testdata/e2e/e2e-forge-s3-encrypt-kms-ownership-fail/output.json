      "control_id": "CTL.S3.ENCRYPT.KMS.OWNERSHIP.001",
      "control_name": "S3 Bucket Encrypted with External Account KMS Key",
      "control_description": "S3 bucket uses a KMS key owned by a different AWS account. The external account controls the key — they can revoke access, disable the key, or modify the key policy at any time. Data encrypted with an externally-owned key is accessible only as long as the external account permits. This is a supply chain risk for encryption.\n",
      "asset_id": "arn:aws:s3:::prod-data-primary",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
