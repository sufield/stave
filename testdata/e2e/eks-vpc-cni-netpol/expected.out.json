      "control_id": "CTL.EKS.VPC.CNI.NETPOL.TTL.001",
      "control_name": "EKS VPC CNI NetworkPolicy Must Have Completed Pod Firewall Cleanup",
      "control_description": "EKS clusters with VPC CNI NetworkPolicy enforcement must have completed pod firewall rule cleanup configured. VPC CNI creates per-IP firewall rules on nodes. Pod completion does not trigger rule removal — only pod deletion does. Without TTL controller or explicit flush, completed pod IPs are recycled with stale rules.\n",
      "asset_id": "arn:aws:eks:us-east-1:123:cluster/staging",
      "asset_type": "eks_cluster",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-10T00:00:00Z",
