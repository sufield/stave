      },
      "remediation": {
        "action": "Restrict grant scope to specific prefixes. Use READ not READWRITE.",
        "description": "An S3 Access Grant exists with broad write permissions.",
        "example": "{ \"storage\": { \"access_grants\": { \"has_broad_write_grant\": false } } }\n"
      }
