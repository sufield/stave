      "control_id": "CTL.DNS.DANGLING.001",
      "control_name": "DNS Records Must Not Point to Unclaimed Resources",
      "control_description": "DNS records (CNAME, ALIAS, A) that reference external cloud resources must resolve to resources that exist and are owned by the organization. A dangling DNS record pointing to a deleted or unclaimed resource enables subdomain takeover — the attacker claims the resource and serves content under the organization's domain.\n",
      "asset_id": "a2.bime.io-cname",
      "asset_type": "dns_record",
      "asset_vendor": "cloudflare",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
        "threshold_hours": 168,
