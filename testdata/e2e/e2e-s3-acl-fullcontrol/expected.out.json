      "asset_vendor": "aws",
      "control_description": "S3 bucket ACLs must not grant FULL_CONTROL to AllUsers or AuthenticatedUsers. FULL_CONTROL is the worst-case ACL misconfiguration — the grantee can read, write, and delete objects and modify the ACL itself.\n",
      "control_id": "CTL.S3.ACL.FULLCONTROL.001",
      "control_name": "No FULL_CONTROL ACL Grants to Public",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "misconfigurations": [
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.access.has_full_control_authenticated",
            "unsafe_value": true
          },
          {
            "actual_value": "[SANITIZED]",
            "operator": "eq",
            "property": "storage.access.has_full_control_public",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "threshold_hours": 168,
        "unsafe_duration_hours": 240,
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 168 hours). Exposed since 2026-01-01T00:00:00Z."
      },
      "posture_drift": {
        "exposure_window_count": 1,
        "pattern": "persistent"
      },
      "remediation": {
        "action": "Replace the bucket ACL with \"BucketOwnerFullControl\" or remove the FULL_CONTROL grant to public groups. Enable S3 Public Access Block with BlockPublicAcls and IgnorePublicAcls set to true.",
        "description": "Bucket ACL grants FULL_CONTROL to AllUsers or AuthenticatedUsers. This grants complete control including object read/write/delete and ACL modification.",
        "example": "{\n  \"storage\": {\n    \"access\": {\n      \"has_full_control_public\": false,\n      \"has_full_control_authenticated\": false\n    }\n  }\n}\n"
