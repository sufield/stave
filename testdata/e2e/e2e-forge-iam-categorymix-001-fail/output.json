      "control_id": "CTL.IAM.ROLE.CATEGORYMIX.001",
      "control_name": "Roles Must Not Span Incompatible Permission Categories",
      "control_description": "IAM roles must not combine permissions from structurally incompatible categories. A role with data_read + iam_write can access data AND modify who else can access it. A role with compute_control + iam_write can create compute AND grant it permissions (Shadow Admin escalation). A role with audit_control + data_read can access data AND cover tracks. No single permission is alarming. The combination is catastrophic. The extractor categorizes permissions against a defined taxonomy and flags roles that span incompatible pairs: data+iam_write, data+secrets, compute+iam_write, audit_control+sensitive, crypto_control+data.\n",
      "asset_id": "arn:aws:iam::123:role/test-role",
      "asset_type": "aws_iam_role",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
