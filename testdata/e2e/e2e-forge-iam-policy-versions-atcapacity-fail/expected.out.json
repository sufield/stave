      "control_id": "CTL.IAM.POLICY.VERSIONS.ATCAPACITY.001",
      "control_name": "Managed Policy at Version Capacity",
      "control_description": "A customer-managed IAM policy has 5 versions (AWS maximum). iam:CreatePolicyVersion requires deleting a version first, but iam:SetDefaultPolicyVersion can still activate any existing dormant version without deletion. At capacity, the attack surface is frozen — the set of potentially-exploitable versions is fixed.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
