      "control_id": "CTL.IAM.ESCALATE.UPDATEFUNCTIONCONFIG.001",
      "control_name": "Principal Must Not Escalate via Lambda UpdateFunctionConfiguration",
      "control_description": "Principals with lambda:UpdateFunctionConfiguration can modify a Lambda function's environment variables, VPC configuration, and runtime settings without changing its code. Environment variables often contain secrets (API keys, database credentials, tokens). The attacker can exfiltrate these by adding an environment variable that sends secrets to an external endpoint, or modify VPC settings to route traffic through an attacker-controlled network.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
