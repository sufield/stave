      "finding_id": "sha256:c26058c61a6eadb7",
      "control_id": "CTL.SNS.POLICY.PUBLIC.001",
      "control_name": "SNS Topic Policy Must Not Allow Public Access",
      "control_description": "SNS topic resource policies must not grant sns:Subscribe, sns:Publish, or sns:* to Principal \"*\" or to unauthenticated principals without restricting via aws:SourceArn, aws:SourceAccount, or aws:PrincipalOrgID conditions. Public topic access allows unauthorized subscription (receiving all published messages) or publishing (injecting messages that reach all subscribers, potentially triggering downstream Lambda functions, SQS queues, or HTTP endpoints).\n",
      "asset_id": "arn:aws:sns:us-east-1:111122223333:deploy-notifications",
      "asset_type": "aws_sns_topic",
      "asset_vendor": "aws",
      "evidence": {
