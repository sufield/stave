      "control_id": "CTL.CODEARTIFACT.EXTERNAL.UNRESTRICTED.001",
      "control_name": "CodeArtifact Repository External Connection Without Origin Restrictions",
      "control_description": "CodeArtifact repository has an external connection to a public upstream (npmjs, PyPI, Maven Central) but does not enforce package origin restrictions. Without restrictions, any package published to the public upstream is automatically available in the internal registry — the exact vector exploited in dependency confusion and typosquatting attacks.\n",
      "asset_id": "arn:aws:codeartifact:us-east-1:111122223333:repository/my-domain/my-repo",
      "asset_type": "aws_codeartifact_repository",
      "asset_vendor": "aws",
