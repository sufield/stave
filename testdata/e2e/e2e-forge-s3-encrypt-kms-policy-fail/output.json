      "control_id": "CTL.S3.ENCRYPT.KMS.POLICY.001",
      "control_name": "KMS Key Policy for S3 Encryption Is Overly Broad",
      "control_description": "The KMS key used for S3 encryption has an overly broad key policy — kms:* to root, or kms:Decrypt to principals beyond the intended S3 service. An overly broad KMS key policy undermines encryption. If the key policy grants kms:Decrypt to many principals, the encryption is nominal — anyone with decrypt access can read the data regardless of S3 bucket policies.\n",
      "asset_id": "arn:aws:s3:::prod-data-primary",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
