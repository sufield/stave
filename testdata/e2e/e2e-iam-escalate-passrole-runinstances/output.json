      "finding_id": "sha256:106585d84298f90f",
      "control_id": "CTL.IAM.ESCALATE.PASSROLE.RUNINSTANCES.001",
      "control_name": "Principal Must Not Escalate via EC2 RunInstances Instance Profile",
      "control_description": "Principals with iam:PassRole on a role R plus ec2:RunInstances can escalate to R's permissions by launching an EC2 instance with R as its instance profile and executing code on the instance via user-data (first-boot) or direct shell access. When R's effective permissions exceed the principal's own, the running instance can call the IMDS for temporary credentials under R and perform actions the original principal lacks — including IAM mutations if R carries them.\n",
      "asset_id": "arn:aws:iam::111122223333:user/mallory",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
