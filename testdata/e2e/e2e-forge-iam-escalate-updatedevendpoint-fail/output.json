      "finding_id": "sha256:526361e23f2c8ac4",
      "control_id": "CTL.IAM.ESCALATE.UPDATEDEVENDPOINT.001",
      "control_name": "Principal Must Not Escalate via Updating Existing Glue Dev Endpoint",
      "control_description": "Principals with glue:UpdateDevEndpoint on an existing Glue development endpoint can replace the SSH public key and connect to the endpoint. The endpoint runs under its attached IAM role. If the role's permissions exceed the principal's, this is a privilege escalation path. Unlike PassRole-based Glue escalation (which creates a new endpoint), this technique modifies an existing one — no iam:PassRole required. Rhino Security Labs documents this as \"UpdateExistingGlueDevEndpoint\". Note: AWS deprecated Glue dev endpoints in favor of interactive sessions, but existing endpoints remain operational.\n",
      "asset_id": "arn:aws:iam::111122223333:user/data-engineer",
      "asset_type": "aws_iam_user",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
