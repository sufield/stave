      "control_id": "CTL.K8S.RBAC.WEBHOOK.001",
      "control_name": "RBAC Must Restrict Admission Webhook Configuration Access",
      "control_description": "Roles and ClusterRoles must not grant create, update, or delete on mutatingwebhookconfigurations or validatingwebhookconfigurations. Admission webhooks intercept every API request — an attacker with webhook configuration access can inject a mutating webhook that modifies all pod specs, secrets, or deployments passing through the API server.\n",
      "asset_id": "system:controller",
      "asset_type": "k8s_cluster_role",
      "asset_vendor": "kubernetes",
