      "finding_id": "sha256:353ca7b67b03ca51",
      "control_id": "CTL.IAM.PASSROLE.PRODUCTION.001",
      "control_name": "PassRole Must Not Target Production Execution Roles",
      "control_description": "IAM role's iam:PassRole Resource element targets a production execution role. A principal with this permission can deploy compute resources (Lambda, SageMaker, ECS, CodeBuild) using production credentials — reaching production data, secrets, and infrastructure without any promotion gate. This is the bridge between a development notebook and a production data breach: the principal passes the production role to a new resource and operates with full production authority.\n",
      "asset_id": "test-iam-role",
      "asset_type": "aws_iam_role",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-01T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-11T00:00:00Z",
        "unsafe_duration_hours": 240,
        "misconfigurations": [
          {
            "property": "identity.policies.passrole_targets_production",
            "actual_value": true,
            "operator": "eq",
            "unsafe_value": true
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 240 hours (SLA: 0 hours). Exposed since 2026-01-01T00:00:00Z."
      },
