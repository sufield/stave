      "remediation": {
        "description": "IAM role can pass a production execution role to compute services.",
        "action": "Restrict the iam:PassRole Resource element to non-production role ARNs. Use separate roles for development and production, and gate production PassRole behind an approval workflow or break-glass procedure. Add an iam:PassedToService condition to further restrict which service can receive the role.",
        "example": "{\n  \"identity\": {\n    \"kind\": \"role\",\n    \"policies\": {\n      \"passrole_targets_production\": false\n    }\n  }\n}\n"
      },
