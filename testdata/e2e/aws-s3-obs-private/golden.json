  "findings": [
    {
      "finding_id": "sha256:b0b49d8a424e3ef5",
      "control_id": "CTL.S3.OWNERSHIP.001",
      "control_name": "S3 Object Ownership Must Be Bucket Owner Enforced",
      "control_description": "S3 buckets must have Object Ownership set to BucketOwnerEnforced, which disables ACLs entirely. When ACLs are disabled, the bucket owner automatically owns every object regardless of who uploaded it, and access is controlled exclusively through IAM and bucket policies. This eliminates the entire class of ACL-based exposure: public grants, privilege escalation via WRITE_ACP, and object-level ACL overrides. Since April 2023 new buckets default to BucketOwnerEnforced, but buckets created before this date may still have ACLs enabled.\n",
      "asset_id": "private-test-bucket",
      "asset_type": "aws_s3_bucket",
      "asset_vendor": "aws",
      "evidence": {
        "first_unsafe_at": "2026-01-10T00:00:00Z",
        "last_seen_unsafe_at": "2026-01-14T00:00:00Z",
        "unsafe_duration_hours": 120,
        "misconfigurations": [
          {
            "property": "storage.kind",
            "actual_value": "bucket",
            "operator": "eq",
            "unsafe_value": "bucket"
          },
          {
            "property": "storage.object_ownership.rule",
            "actual_value": null,
            "operator": "missing",
            "unsafe_value": true
          },
          {
            "property": "storage.object_ownership.rule",
            "actual_value": null,
            "operator": "ne",
            "unsafe_value": "BucketOwnerEnforced"
          }
        ],
        "root_causes": [
          "general"
        ],
        "temporal_risk": "Asset non-compliant for 120 hours (SLA: 0 hours). Exposed since 2026-01-10T00:00:00Z."
      },
      "control_severity": "high",
