    "identity": {
      "type": "object",
      "additionalProperties": false,
      "title": "Observed Identity",
      "description": "An IAM identity (user, role, service account) and its evaluated properties.",
      "required": [
        "id",
        "type",
        "vendor",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "title": "Identity ID",
          "description": "Unique identifier for this identity (e.g., ARN, email, principal ID)."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Identity Type",
          "description": "Identity type indicating the kind of principal (e.g., iam_role, service_account, user). Lowercase letters, digits, '_', '.', and '-' only."
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "title": "Identity Vendor",
          "description": "Cloud vendor or platform that manages this identity (e.g., aws, gcp, azure)."
        },
        "properties": {
          "type": "object",
          "title": "Identity Properties",
          "description": "Identity attributes evaluated by control predicates. Intentionally flexible (any JSON object)."
        },
