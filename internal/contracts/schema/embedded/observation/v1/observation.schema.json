          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_bedrock_agent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_ebs_snapshot"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_ebs_snapshot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eks_namespace"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_eks_namespace"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_ec2_account"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_ec2_account"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eks_pod_spec"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_eks_pod_spec"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eventbridge_pipe"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_eventbridge_pipe"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_cognito_account"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_cognito_account"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eventbridge_schedule"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_eventbridge_schedule"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eventbridge_rule_target"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_eventbridge_rule_target"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_ec2_launch_template"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_ec2_launch_template"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_iam_account"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_iam_account"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_organization"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_organization"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eks_addon"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
