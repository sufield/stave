{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stave:schema:observation:v1",
  "title": "Stave Observation Contract v1",
  "description": "Contract schema for Stave observation snapshots. Each snapshot captures the configuration state of infrastructure assets at a single point in time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "obs.v1",
        "obs.v0.1"
      ],
      "title": "Schema Version",
      "description": "Schema version identifier. Accepted values allow forward-compatible ingestion of obs.v0.1 documents."
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "title": "Capture Timestamp",
      "description": "UTC timestamp in RFC 3339 format indicating when the observation data was captured."
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "title": "Generator Metadata",
      "description": "Metadata about the tool and provider that generated this observation.",
      "properties": {
        "source_type": {
          "type": "string",
          "title": "Source Type",
          "description": "Source type identifier indicating the extraction method (e.g., aws.config_api, gcp.asset_inventory, custom.script)."
        },
        "tool": {
          "type": "string",
          "title": "Tool Name",
          "description": "Name of the tool that produced this observation (e.g., stave-extract, custom-script)."
        },
        "tool_version": {
          "type": "string",
          "title": "Tool Version",
          "description": "Semantic version of the extraction tool."
        },
        "provider": {
          "type": "string",
          "title": "Provider Name",
          "description": "Cloud or infrastructure provider name (e.g., aws, gcp, azure)."
        },
        "provider_version": {
          "type": "string",
          "title": "Provider Version",
          "description": "Version of the provider plugin or API used during extraction."
        }
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "deployed",
        "planned",
        "local"
      ],
      "title": "Snapshot Source",
      "description": "Origin context of the snapshot: deployed (CI/CD or scheduled scan), planned (IaC plan), or local (developer workstation)."
    },
    "assets": {
      "type": "array",
      "title": "Assets",
      "description": "List of infrastructure assets captured in this observation snapshot.",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "identities": {
      "type": "array",
      "title": "Identities",
      "description": "List of IAM identities captured in this observation snapshot.",
      "items": {
        "$ref": "#/$defs/identity"
      }
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "title": "Source Reference",
      "description": "Reference to the source file and line from which this element was extracted.",
      "properties": {
        "file": {
          "type": "string",
          "title": "Source File Path",
          "description": "Path to the source file (e.g., Terraform config, API response cache)."
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "title": "Source Line Number",
          "description": "Line number in the source file where this element is defined."
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "title": "Observed Asset",
      "description": "A single infrastructure asset and its configuration properties.",
      "required": [
        "id",
        "type",
        "vendor",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "title": "Asset ID",
          "description": "Unique identifier for this asset (e.g., ARN, asset name, or synthetic ID)."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Asset Type",
          "description": "Asset type indicating the kind of infrastructure (e.g., storage_bucket, iam_role, k8s.clusterrolebinding). Lowercase letters, digits, '_', '.', and '-' only."
        },
        "vendor": {
          "type": "string",
          "minLength": 1,
          "title": "Asset Vendor",
          "description": "Cloud vendor or platform that provides this asset (e.g., aws, gcp, azure)."
        },
        "properties": {
          "type": "object",
          "title": "Configuration Properties",
          "description": "Asset configuration properties evaluated by control predicates. Outer envelope is any JSON object; per-asset-type shape is refined by the allOf/if-then dispatch below, keyed on the asset's type field."
        },
        "source": {
          "$ref": "#/$defs/sourceRef",
          "title": "Source Reference",
          "description": "Optional reference to the source file and line for traceability."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_stepfunctions_state_machine"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_stepfunctions_state_machine"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_opensearch_domain"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_opensearch_domain"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_s3_bucket"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_s3_bucket"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_cognito_user_pool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_cognito_user_pool"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_lambda_function"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_lambda_function"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_cloudtrail_trail"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_cloudtrail_trail"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_kms_key"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_kms_key"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_ec2_instance"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_ec2_instance"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_sqs_queue"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_sqs_queue"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_iam_user"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_iam_user"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_iam_role"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_iam_role"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_sns_topic"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_sns_topic"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_ec2_security_group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_ec2_security_group"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eks_cluster"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "$ref": "urn:stave:schema:asset-type:aws_eks_cluster"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "aws_eventbridge_bus"
              }
            },
            "required": [
