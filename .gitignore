stave-dev
.artifacts/
/stave
.claude/

.stave/
python/solver/tests/__pycache__/
../.tools-venv/

# Local content-hash caches for the sync-* Makefile targets (see the
# top of Makefile). They let the syncs skip rm/cp when source is
# unchanged. CI never has these — clean checkouts re-sync every time,
# so correctness is unaffected.
.build-cache/
.sync-schemas-hash
.sync-controls-hash
.sync-alternatives-hash
stave-mcp
.work/

# e2e enforce scenarios regenerate their --out dir every run and verify it by
# sha256 (expected.generated.path + expected.generated.sha256 are the goldens),
# so the generated tree itself must never be tracked. See e2e/e2e_test.go
# (RemoveAll(caseDir/outdir) before each run).
testdata/e2e/*/outdir/

# Reasoning-spec run.sh regenerates Soufflé/Z3 fact dirs (facts-vuln/-fp/-fn)
# on every run; expected/output.txt is the committed artifact, not the facts.
examples/*/facts-*/

# IAM authorization reference cache (fetched by make sync-iamauth)
data/iamauth/
