# Exercise the snapshot diff subcommand with real data. The lifecycle
# subcommands (quality, upcoming, plan, status, risk) were removed —
# snapshot lifecycle management is the upstream system's job.

# Snapshot diff
exec stave snapshot diff --observations observations --format json
stdout 'start_time'

-- controls/CTL.S3.PUBLIC.001.yaml --
dsl_version: ctrl.v1
id: CTL.S3.PUBLIC.001
name: No Public S3 Bucket Read
description: Test.
domain: exposure
severity: critical
classification: aggregate_check
type: unsafe_duration
params:
  max_unsafe_duration: "168h"
scope_tags:
  - aws
  - s3
unsafe_predicate:
  all:
    - field: properties.storage.access.public_read
      op: eq
      value: true

-- observations/2026-01-09T000000Z.json --
{
  "schema_version": "obs.v0.1",
  "source": "deployed",
  "generated_by": {"source_type": "aws-s3-snapshot", "tool": "stave-extractor"},
  "captured_at": "2026-01-09T00:00:00Z",
  "assets": [{
    "id": "test-bucket",
    "type": "aws_s3_bucket",
    "vendor": "aws",
    "properties": {"storage": {"access": {"public_read": true}}}
  }]
}

