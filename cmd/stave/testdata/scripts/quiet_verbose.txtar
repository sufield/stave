# Verify --quiet and --verbose flags (clig.dev § Verbosity)

# --quiet suppresses non-essential output
exec stave apply --controls controls --observations observations-clean --max-unsafe 168h --eval-time 2026-01-11T00:00:00Z --quiet --format json
! stderr 'No violations'
stdout '"schema_version"'

# --quiet with violations still exits 3
! exec stave apply --controls controls --observations observations --max-unsafe 24h --eval-time 2026-01-11T00:00:00Z --quiet --format json

# Default (no --log-level): warn-level records suppressed by accumulator
exec stave apply --controls controls --observations observations-clean --max-unsafe 168h --eval-time 2026-01-11T00:00:00Z --format json
! stderr 'level=WARN'

# --log-level warn: warn-level records shown inline
exec stave apply --controls controls --observations observations-clean --max-unsafe 168h --eval-time 2026-01-11T00:00:00Z --format json --log-level warn
stderr 'level=WARN'

-- controls/CTL.TEST.001.yaml --
dsl_version: ctrl.v1
id: CTL.TEST.001
name: Test Control
description: Test.
domain: exposure
severity: high
classification: aggregate_check
type: unsafe_duration
params:
  max_unsafe_duration: "12h"
unsafe_predicate:
  all:
    - field: properties.public
      op: eq
      value: true

